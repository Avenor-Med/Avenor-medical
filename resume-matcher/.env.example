# Copy this file to `.env` and fill in your Anthropic API key.
# Get one at https://console.anthropic.com (free $5 credit for new accounts)

ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# Optional: which model to use (Haiku is cheap + fast, Sonnet is more accurate)
# Options: claude-3-5-haiku-20241022 (recommended), claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Optional: geographic focus. "TX" = Texas only, "US" = nationwide
# For Friday's demo of Dallas + nationwide, use US
GEO_FOCUS=US

# Optional: how many top matches per candidate to report (default: 10)
TOP_MATCHES=10
