# Public site URL — used for canonical links, sitemap, and OG tags
NEXT_PUBLIC_SITE_URL=https://avenormedical.com

# Supabase — from your project dashboard: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. Never expose to the browser. Used by API routes and cron.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Claude API — resume parsing
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-sonnet-4-5

# Cron protection
CRON_SECRET=generate-a-long-random-string

# Job ingestion sources (all free tiers; cron runs nightly)
USAJOBS_EMAIL=your-official-company-email@avenormedical.com
USAJOBS_AUTH_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
