# Database (SQLite — file path is relative to /prisma)
DATABASE_URL="file:./dev.db"

# Anthropic API key — used for AI-powered CV parsing.
# If left blank, the app falls back to realistic mock parsing so the demo still works.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Session secret — used to sign auth cookies. Set to any long random string in production.
SESSION_SECRET="change-me-in-prod-this-is-a-dev-only-secret-1234567890"
